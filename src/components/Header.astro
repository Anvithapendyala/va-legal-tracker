---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { getAssetPath, stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-foreground absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="bg-header-background text-header-foreground w-full">
  <div class="mx-auto max-w-7xl px-4">
    <div
      class="border-header-foreground/20 relative flex w-full flex-col justify-between border-b py-4 lg:flex-row lg:items-center lg:py-5"
    >
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="flex items-center gap-3 py-1 leading-tight"
      >
        <div class="flex min-w-0 flex-col">
          <span class="font-heading text-2xl font-bold sm:text-3xl"
            >{site.title}</span
          >
          <span
            class="border-header-foreground/25 text-header-foreground/75 mt-2 inline-flex w-fit rounded-full border px-2.5 py-1 text-[0.6rem] font-semibold tracking-[0.12em] uppercase sm:text-[0.65rem]"
          >
            VA + US Legal &amp; Financial Briefings
          </span>
        </div>
        <img
          src={getAssetPath("logo.png")}
          alt=""
          width="48"
          height="48"
          class="h-10 w-10 shrink-0 object-contain sm:h-12 sm:w-12"
        />
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center lg:ms-4 lg:w-auto lg:flex-row lg:justify-end"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 lg:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class="[&>li>a]:hover:text-accent mt-4 hidden w-full grid-cols-2 place-content-center gap-2 lg:mt-0 lg:flex lg:w-auto lg:flex-nowrap lg:gap-x-3 lg:gap-y-0 xl:gap-x-6 lg:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-1.5 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:text-base [&>li>a]:font-medium [&>li>a]:whitespace-nowrap lg:[&>li>a]:px-1 lg:[&>li>a]:py-1"
        >
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "rights-checker")}
              class:list={{ "active-nav": isActive("/rights-checker") }}
            >
              Rights &amp; Wallet Checker
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "juvenile-brief")}
              class:list={{ "active-nav": isActive("/juvenile-brief") }}
            >
              The Juvenile Brief
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "fine-print")}
              class:list={{ "active-nav": isActive("/fine-print") }}
            >
              The Fine Print
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <div
              class="reference-nav relative flex items-center justify-center gap-0.5"
            >
              <a
                href={getRelativeLocaleUrl(locale, "reference")}
                class:list={{
                  "active-nav": isActive("/reference"),
                  "px-1 py-3 text-base font-medium whitespace-nowrap lg:py-1": true,
                }}
              >
                Reference
              </a>
              <details class="reference-menu relative">
                <summary
                  aria-label="Open Reference guides"
                  class="text-header-foreground/80 hover:text-accent cursor-pointer rounded p-1 text-xs"
                >
                  <span aria-hidden="true">⌄</span>
                </summary>
                <ul
                  class="reference-submenu border-header-foreground/20 bg-header-background absolute end-0 top-full z-50 min-w-60 rounded-xl border p-2 text-start shadow-xl"
                >
                  <li>
                    <a
                      href={getRelativeLocaleUrl(locale, "reference")}
                      class="text-header-foreground hover:bg-header-foreground/10 hover:text-accent block rounded-lg px-3 py-2 text-sm"
                    >
                      Reference Library
                    </a>
                  </li>
                  <li>
                    <a
                      href={getRelativeLocaleUrl(
                        locale,
                        "reference/amendments"
                      )}
                      class="text-header-foreground hover:bg-header-foreground/10 hover:text-accent block rounded-lg px-3 py-2 text-sm"
                    >
                      Constitutional Amendments
                    </a>
                  </li>
                  <li>
                    <a
                      href={getRelativeLocaleUrl(
                        locale,
                        "reference/virginia-code"
                      )}
                      class="text-header-foreground hover:bg-header-foreground/10 hover:text-accent block rounded-lg px-3 py-2 text-sm"
                    >
                      Virginia Code Essentials
                    </a>
                  </li>
                  <li>
                    <a
                      href={getRelativeLocaleUrl(
                        locale,
                        "reference/courts-glossary"
                      )}
                      class="text-header-foreground hover:bg-header-foreground/10 hover:text-accent block rounded-lg px-3 py-2 text-sm"
                    >
                      Courts &amp; Glossary
                    </a>
                  </li>
                  <li>
                    <a
                      href={getRelativeLocaleUrl(
                        locale,
                        "reference/money-playbooks"
                      )}
                      class="text-header-foreground hover:bg-header-foreground/10 hover:text-accent block rounded-lg px-3 py-2 text-sm"
                    >
                      Money &amp; Consumer Playbooks
                    </a>
                  </li>
                </ul>
              </details>
            </div>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class:list={{ "active-nav": isActive("/posts") }}
            >
              Law Tracker
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class:list={{ "active-nav": isActive("/about") }}
            >
              About
            </a>
          </li>
          {
            features.search !== false && (
              <li class="col-span-1 flex items-center justify-center">
                <LinkButton
                  href={getRelativeLocaleUrl(locale, "search")}
                  class:list={["focus-outline relative size-8"]}
                  title={t.nav.search}
                  aria-label={t.nav.search}
                >
                  <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                  <span class="sr-only">{t.nav.search}</span>
                  {isActive("/search") && (
                    <IconUnderline
                      aria-hidden="true"
                      class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                    />
                  )}
                </LinkButton>
              </li>
            )
          }
          {
            features.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline hover:[&>svg]:stroke-accent relative size-12 p-4 sm:size-8"
                  title={t.a11y.toggleTheme}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView();
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<style>
  .reference-menu > summary {
    list-style: none;
  }

  .reference-menu > summary::-webkit-details-marker {
    display: none;
  }

  .reference-submenu {
    display: none;
  }

  .reference-nav:hover .reference-submenu,
  .reference-nav:focus-within .reference-submenu,
  .reference-menu[open] .reference-submenu {
    display: block;
  }
</style>
