  function initializeDocumentDecoders() {
    document
      .querySelectorAll<HTMLElement>("[data-document-decoder]")
      .forEach(root => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";

        const tabs = Array.from(
          root.querySelectorAll<HTMLButtonElement>("[data-document-tab]")
        );
        const panels = Array.from(
          root.querySelectorAll<HTMLElement>("[data-document-panel]")
        );
        const detailCopy =
          root.querySelector<HTMLElement>("[data-detail-copy]");
        const detailSource = root.querySelector<HTMLElement>(
          "[data-detail-source]"
        );
        const detailLink =
          root.querySelector<HTMLAnchorElement>("[data-detail-link]");
        if (!detailCopy || !detailSource || !detailLink) return;

        const setDocument = (id: string) => {
          tabs.forEach(tab => {
            const active = tab.dataset.documentTab === id;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
            tab.classList.toggle("bg-marigold", active);
            tab.classList.toggle("text-forest", active);
            tab.classList.toggle("border", !active);
            tab.classList.toggle("border-border", !active);
            tab.classList.toggle("text-foreground", !active);
          });
          panels.forEach(panel => {
            panel.hidden = panel.dataset.documentPanel !== id;
          });
          root
            .querySelectorAll<HTMLButtonElement>("[data-clause]")
            .forEach(button => button.setAttribute("aria-pressed", "false"));
          detailCopy.textContent =
            "Choose a highlighted clause in the document to see what it may mean and which law or contract term to check.";
          detailSource.textContent = "";
          detailLink.hidden = true;
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => {
            const id = tab.dataset.documentTab;
            if (id) setDocument(id);
          });
          tab.addEventListener("keydown", event => {
            if (
              event.key !== "ArrowRight" &&
              event.key !== "ArrowLeft" &&
              event.key !== "Home" &&
              event.key !== "End"
            ) {
              return;
            }
            event.preventDefault();
            const nextIndex =
              event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : (index +
                      (event.key === "ArrowRight" ? 1 : -1) +
                      tabs.length) %
                    tabs.length;
            tabs[nextIndex]?.focus();
            const id = tabs[nextIndex]?.dataset.documentTab;
            if (id) setDocument(id);
          });
        });

        root.addEventListener("click", event => {
          if (!(event.target instanceof Element)) return;
          const clause =
            event.target.closest<HTMLButtonElement>("[data-clause]");
          if (!clause) return;
          const key = clause.dataset.clause;
          const detail = key ? clauseDetails[key] : undefined;
          if (!detail) return;

          root
            .querySelectorAll<HTMLButtonElement>("[data-clause]")
            .forEach(button =>
              button.setAttribute("aria-pressed", String(button === clause))
            );
          detailCopy.textContent = detail.explanation;
          detailSource.textContent = detail.source;
          detailLink.href = detail.href;
          detailLink.textContent = detail.link;
          detailLink.hidden = false;
          root
            .querySelector("[data-clause-explanation-title]")
            ?.replaceChildren(document.createTextNode(detail.title));
        });
      });
  }

  initializeDocumentDecoders();
  document.addEventListener("astro:page-load", initializeDocumentDecoders);
