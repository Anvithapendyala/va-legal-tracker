<style>
  .clause-highlight {
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--manila) 34%, transparent);
    color: var(--foreground);
    font-weight: 700;
    padding: 0.1rem 0.25rem;
    text-decoration: underline;
    text-decoration-color: var(--stamp-red);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .clause-highlight:hover,
  .clause-highlight[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .clause-highlight:focus-visible {
    outline: 2px dashed var(--foreground);
    outline-offset: 3px;
  }
</style>

