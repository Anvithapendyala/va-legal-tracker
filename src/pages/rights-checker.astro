---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RightsChecker from "@/components/RightsChecker.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const matchingBriefings = [
  { slug: "fourth-amendment-school-searches", label: "School searches" },
  { slug: "mahanoy-student-speech-1st-amendment", label: "Off-campus speech" },
  {
    slug: "fifth-amendment-juvenile-miranda-rights",
    label: "Police questioning",
  },
  { slug: "virginia-teen-wage-rights", label: "Paychecks & breaks" },
  { slug: "cfpb-hidden-bank-fees-tracker", label: "Bank fees" },
  {
    slug: "virginia-security-deposit-tenant-rights",
    label: "Security deposits",
  },
  {
    slug: "virginia-health-spa-gym-cancellation-law",
    label: "Gym memberships",
  },
  { slug: "virginia-minors-driving-curfew-laws", label: "Teen driving" },
];
---

<Layout
  title="Rights & Wallet Checker | Virginia Legal Brief"
  description="Explore eight interactive Virginia and federal rights scenarios covering school searches, speech, police questioning, paychecks, bank fees, housing, subscriptions, and teen driving."
>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-10 sm:py-14">
    <header class="mb-8 max-w-3xl">
      <p class="text-foreground text-xs font-bold tracking-[0.16em] uppercase">
        A practical starting point
      </p>
      <h1 class="mt-3 text-4xl leading-tight font-bold sm:text-5xl">
        Rights &amp; Wallet Checker
      </h1>
      <p
        class="text-muted-foreground mt-4 text-base leading-relaxed sm:text-lg"
      >
        Choose a school, work, money, housing, or driving situation. Answer two
        quick questions to find the legal rules and matching briefing.
      </p>
    </header>
    <RightsChecker mode="full" />
    <nav class="mt-7" aria-label="Matching legal briefings">
      <h2 class="text-forest text-sm font-bold">
        Explore the matching briefings
      </h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          matchingBriefings.map(briefing => (
            <li>
              <a
                href={getPostUrl(briefing.slug, undefined, locale)}
                class="border-border bg-muted text-forest hover:border-forest inline-flex rounded-full border px-3 py-2 text-sm font-semibold transition"
              >
                {briefing.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
  <Footer />
</Layout>
