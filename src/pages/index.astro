---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RightsChecker from "@/components/RightsChecker.astro";
import YouDecide from "@/components/YouDecide.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const latestPosts = getSortedPosts(posts);

const primarySources: Record<string, string> = {
  "cfpb-hidden-bank-fees-tracker":
    "https://www.consumerfinance.gov/rules-policy/regulations/1005/17/",
  "virginia-teen-wage-rights":
    "https://law.lis.virginia.gov/vacode/title40.1/chapter3/section40.1-29/",
  "virginia-security-deposit-tenant-rights":
    "https://law.lis.virginia.gov/vacode/title55.1/chapter12/section55.1-1226/",
  "mahanoy-student-speech-1st-amendment":
    "https://supreme.justia.com/cases/federal/us/594/180/",
  "fourth-amendment-school-searches":
    "https://supreme.justia.com/cases/federal/us/469/325/",
  "fifth-amendment-juvenile-miranda-rights":
    "https://supreme.justia.com/cases/federal/us/564/261/",
  "in-re-gault-juvenile-due-process":
    "https://supreme.justia.com/cases/federal/us/387/1/",
  "virginia-minors-driving-curfew-laws":
    "https://law.lis.virginia.gov/vacode/title46.2/chapter3/section46.2-334.01/",
  "credit-card-act-young-adults":
    "https://www.law.cornell.edu/uscode/text/15/1637",
  "tinker-v-des-moines-student-expression":
    "https://supreme.justia.com/cases/federal/us/393/503/",
  "virginia-health-spa-gym-cancellation-law":
    "https://law.lis.virginia.gov/vacode/title59.1/chapter24/section59.1-297/",
  "fourth-circuit-student-digital-privacy":
    "https://law.justia.com/cases/federal/appellate-courts/F3/206/392/",
  "virginia-unclaimed-property-act-guide":
    "https://law.lis.virginia.gov/vacode/title55.1/chapter25/section55.1-2501/",
  "cfpb-buy-now-pay-later-protections":
    "https://www.federalregister.gov/documents/2025/05/12/2025-08286/interpretive-rules-policy-statements-and-advisory-opinions-withdrawal",
  "virginia-minimum-wage-youth-exemptions":
    "https://law.lis.virginia.gov/vacode/title40.1/chapter3/section40.1-28.9/",
};

const dateLabel = (date: Date) =>
  date
    .toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    })
    .toUpperCase();
---

<Layout
  title="Virginia Legal Brief | Virginia & Federal Legal Briefings"
  description="Explore Virginia and federal cases, everyday rights, and money questions through plain-English legal briefings."
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={getRelativeLocaleUrl(locale, "")}
    class="mx-auto w-full max-w-7xl px-4 py-8 sm:py-12"
  >
    <section
      class="grid items-start gap-8 md:grid-cols-2 md:items-center md:gap-10"
    >
      <div class="py-2">
        <p
          class="text-foreground text-xs font-bold tracking-[0.16em] uppercase"
        >
          Virginia &amp; Federal Legal Briefings
        </p>
        <h1
          class="font-heading text-forest mt-4 max-w-xl text-5xl leading-[1.05] font-bold sm:text-6xl"
        >
          Your school. Your paycheck. Your rights.
        </h1>
        <p
          class="text-muted-foreground mt-5 max-w-lg text-base leading-relaxed sm:text-lg"
        >
          Clear reporting on the cases and laws that shape everyday rights and
          financial decisions.
        </p>
      </div>
      <div>
        <RightsChecker mode="home" />
        <a
          href={getRelativeLocaleUrl(locale, "rights-checker")}
          class="text-forest decoration-manila mt-3 inline-flex text-sm font-semibold underline decoration-2 underline-offset-4 hover:decoration-4"
        >
          Explore all 8 scenarios in the Rights &amp; Wallet Checker →
        </a>
      </div>
    </section>

    <section class="mt-10 sm:mt-14" aria-label="Featured juvenile case file">
      <YouDecide
        caseId="jdb"
        eyebrow="The Juvenile Brief · Landmark case"
        prompt="“You’re 13. A police officer calls you out of class. Would you feel free to leave?”"
        choices={[
          {
            label: "Yes — it wasn't a formal arrest",
            value: "formal-arrest",
          },
          {
            label: "No — a 13-year-old at school wouldn't feel free to leave",
            value: "age-and-setting",
          },
        ]}
        correctChoice="age-and-setting"
        ruling="The U.S. Supreme Court ruled 5–4 that a child's age must be considered when deciding whether a reasonable person in that child's position would have felt free to leave, if the age was known or objectively apparent to the officer."
        studentImpact="That rule applies to Virginia students. It does not make every school interview a custodial interrogation or require a parent in every conversation; the circumstances matter."
        sourceLabel="U.S. SUPREME COURT · 5TH AMEND."
        briefingHref={getPostUrl(
          "fifth-amendment-juvenile-miranda-rights",
          undefined,
          locale
        )}
        briefingLinkText="Read the J.D.B. case briefing"
      />
    </section>

    <section
      class="mt-12 grid gap-8 sm:mt-16 lg:grid-cols-12"
      aria-label="Latest changes and active watchlist"
    >
      <section class="lg:col-span-7" aria-labelledby="latest-changes-title">
        <div
          class="border-border flex flex-wrap items-end justify-between gap-4 border-b pb-4"
        >
          <div>
            <p
              class="text-foreground text-xs font-bold tracking-[0.16em] uppercase"
            >
              Virginia &amp; U.S. law
            </p>
            <h2
              id="latest-changes-title"
              class="mt-2 text-3xl font-bold sm:text-4xl"
            >
              Latest changes
            </h2>
          </div>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="text-forest decoration-manila text-sm font-bold underline decoration-2 underline-offset-4 hover:decoration-4"
          >
            Full case library →
          </a>
        </div>

        <ul class="divide-border divide-y">
          {
            latestPosts.slice(0, 4).map(post => (
              <li class="py-5 sm:py-6">
                <div class="flex flex-wrap items-center gap-2.5">
                  <time
                    class="text-muted-foreground text-xs font-bold tracking-[0.1em]"
                    datetime={post.data.pubDatetime.toISOString()}
                  >
                    {dateLabel(post.data.pubDatetime)}
                  </time>
                  <span class="bg-manila text-forest rounded-sm px-2.5 py-1 text-[0.65rem] font-bold tracking-wide">
                    {post.data.sourceLabel}
                  </span>
                </div>
                <p class="text-foreground mt-2 max-w-4xl text-sm leading-relaxed sm:text-base">
                  {post.data.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold">
                  <a
                    href={primarySources[post.id]}
                    target="_blank"
                    rel="noreferrer"
                    class="text-forest decoration-manila underline underline-offset-4 hover:decoration-2"
                  >
                    Primary source ↗
                  </a>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="text-forest decoration-manila underline underline-offset-4 hover:decoration-2"
                  >
                    Read briefing →
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <aside
        class="border-border bg-parchment flex flex-col rounded-2xl border p-5 shadow-sm sm:p-6 lg:col-span-5"
        aria-labelledby="watchlist-preview-title"
      >
        <p class="text-forest text-xs font-bold tracking-[0.16em] uppercase">
          2027 Live Watchlist
        </p>
        <h2
          id="watchlist-preview-title"
          class="font-heading text-forest mt-2 text-2xl font-bold"
        >
          2027 VA &amp; Federal Watchlist
        </h2>
        <ul class="divide-border mt-4 flex-1 divide-y">
          <li class="py-3 first:pt-0">
            <a
              href={getPostUrl(
                "virginia-minimum-wage-youth-exemptions",
                undefined,
                locale
              )}
              class="group focus-visible:outline-accent block rounded-sm focus-visible:outline-2 focus-visible:outline-dashed"
            >
              <span
                class="bg-forest text-parchment inline-flex rounded-full px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.08em]"
              >
                JAN 2027 SESSION
              </span>
              <span class="text-foreground mt-2 block text-sm leading-relaxed">
                Virginia’s scheduled $13.75 minimum wage may change what young
                workers take home.
              </span>
            </a>
          </li>
          <li class="py-3">
            <a
              href={getPostUrl(
                "fourth-circuit-student-digital-privacy",
                undefined,
                locale
              )}
              class="group focus-visible:outline-accent block rounded-sm focus-visible:outline-2 focus-visible:outline-dashed"
            >
              <span
                class="bg-forest text-parchment inline-flex rounded-full px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.08em]"
              >
                4TH CIRCUIT
              </span>
              <span class="text-foreground mt-2 block text-sm leading-relaxed">
                Workplace device precedent—and its limits—matter when students’
                digital privacy is at stake.
              </span>
            </a>
          </li>
          <li class="py-3">
            <a
              href={getPostUrl(
                "mahanoy-student-speech-1st-amendment",
                undefined,
                locale
              )}
              class="group focus-visible:outline-accent block rounded-sm focus-visible:outline-2 focus-visible:outline-dashed"
            >
              <span
                class="bg-forest text-parchment inline-flex rounded-full px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.08em]"
              >
                U.S. SUPREME COURT
              </span>
              <span class="text-foreground mt-2 block text-sm leading-relaxed">
                Off-campus speech rules shape when public schools can discipline
                students.
              </span>
            </a>
          </li>
        </ul>
        <a
          href={getRelativeLocaleUrl(locale, "watchlist")}
          class="bg-marigold text-forest mt-4 inline-flex w-full justify-center rounded-lg px-4 py-3 text-center text-sm font-bold transition hover:brightness-95"
        >
          Track All Active Bills &amp; Cases →
        </a>
      </aside>
    </section>

    <section class="mt-12 sm:mt-16" aria-labelledby="reference-guides-title">
      <div class="border-border border-b pb-4">
        <p
          class="text-foreground text-xs font-bold tracking-[0.16em] uppercase"
        >
          Start with the source
        </p>
        <h2
          id="reference-guides-title"
          class="mt-2 text-3xl font-bold sm:text-4xl"
        >
          Reference &amp; Guides
        </h2>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href={getRelativeLocaleUrl(locale, "reference/amendments")}
          class="border-border bg-muted group hover:border-forest rounded-xl border p-5 transition"
        >
          <h3 class="font-heading text-forest text-lg font-bold">
            Constitutional Amendments
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Plain-English breakdowns of the 1st, 4th, 5th, 6th, 8th, and 14th
            Amendments.
          </p>
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "reference/virginia-code")}
          class="border-border bg-muted group hover:border-forest rounded-xl border p-5 transition"
        >
          <h3 class="font-heading text-forest text-lg font-bold">
            Virginia Code Essentials
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Key state statutes on teen wages, leases, driving curfews, and
            consumer protection.
          </p>
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "reference/courts-glossary")}
          class="border-border bg-muted group hover:border-forest rounded-xl border p-5 transition"
        >
          <h3 class="font-heading text-forest text-lg font-bold">
            Court System &amp; Glossary
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            How Virginia and federal courts work plus plain-English legal and
            financial terms.
          </p>
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "reference/money-playbooks")}
          class="border-border bg-muted group hover:border-forest rounded-xl border p-5 transition"
        >
          <h3 class="font-heading text-forest text-lg font-bold">
            Money &amp; Consumer Playbooks
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Practical guides on pay stubs, credit cards, overdrafts, and
            subscriptions.
          </p>
        </a>
      </div>
    </section>

    <section
      class="border-border bg-muted mt-12 flex flex-col gap-5 rounded-2xl border p-6 sm:mt-16 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      aria-labelledby="homepage-contact-title"
    >
      <div>
        <p class="text-forest text-xs font-bold tracking-[0.16em] uppercase">
          Help shape the next briefing
        </p>
        <h2 id="homepage-contact-title" class="mt-2 text-2xl font-bold">
          Have a question about law or money?
        </h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Send it to the Virginia Legal Brief editorial desk for a response
          within 24 hours.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:items-end">
        <a
          href={getRelativeLocaleUrl(locale, "get-involved")}
          class="bg-marigold text-forest inline-flex justify-center rounded-lg px-5 py-3 text-sm font-bold transition hover:brightness-95"
        >
          Submit a question →
        </a>
        <a
          href="mailto:virginialegalbrief@gmail.com"
          class="text-forest decoration-manila text-sm font-semibold underline underline-offset-4"
        >
          virginialegalbrief@gmail.com
        </a>
      </div>
    </section>
  </main>
  <a
    href={getRelativeLocaleUrl(locale, "get-involved")}
    class="bg-forest text-marigold hover:bg-forest/90 fixed top-1/2 right-0 z-40 hidden -translate-y-1/2 rounded-s-lg px-3 py-4 text-sm font-bold shadow-lg transition xl:flex"
    style="writing-mode: vertical-rl"
  >
    Get Involved / Ask →
  </a>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector<HTMLElement>("#main-content");
    if (mainContent?.dataset.layout !== "index") return;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    sessionStorage.setItem("backUrl", mainContent.dataset.homePath ?? baseRoot);
  });
</script>
